# =====================================================================================
#  Plantilla de variables de entorno. Copia este archivo a .env y rellena los valores.
#
#      cp .env.example .env
#
#  .env esta en .gitignore: NUNCA se versiona. Aqui no hay ni un secreto real.
# =====================================================================================

# --- Gateway ---------------------------------------------------------------------
# Puerto de host propio para no chocar con otros demos.
GATEWAY_PORT=9090

# --- AWS Cognito -----------------------------------------------------------------
# Los DOS microservicios arman el mismo issuer con estas dos variables:
#   https://cognito-idp.${COGNITO_REGION}.amazonaws.com/${COGNITO_USER_POOL_ID}
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# El App Client se usa SOLO desde Postman para pedir el token; el backend no lo necesita.
COGNITO_APP_CLIENT_ID=cambia-esto

# --- Base de datos del microservicio users ---------------------------------------
USERS_DB_NAME=users_db
USERS_DB_USER=users_app
USERS_DB_PASSWORD=cambia-esta-clave

# --- Base de datos del microservicio matchpoint ----------------------------------
MATCHPOINT_DB_NAME=matchpoint_db
MATCHPOINT_DB_USER=matchpoint_app
MATCHPOINT_DB_PASSWORD=cambia-esta-clave

# --- Explorador de base de datos (pgAdmin) ---------------------------------------
PGADMIN_EMAIL=admin@puce.edu.ec
PGADMIN_PASSWORD=cambia-esta-clave
